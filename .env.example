# API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=bizguide-index-v2

# App settings
ENVIRONMENT=development
LOG_LEVEL=info
REDIS_URL=
METRICS_ENABLED=true
ASYNC_DOCUMENT_INGESTION_ENABLED=false
DOCUMENT_STORAGE_BUCKET=documents
DOCUMENT_WORKER_POLL_SECONDS=2
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_JOB_LEASE_SECONDS=900

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=  # server-only; required for async document workers
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here  # required only for HS256/legacy signing
SUPABASE_JWKS_URL=

# Admin (optional – needed for /api/documents/clear-all)
ADMIN_SECRET=your_admin_secret_here

# Frontend URL (used for CORS in production)
FRONTEND_URL=http://localhost:5173
